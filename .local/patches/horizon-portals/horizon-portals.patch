+/// Horizon portals: the columns whose blocks changed, by level, while someone looks through a
+/// portal into it (`game/portal_view.rs` sends them again).
+pub mod portal_changes {
+    use std::collections::{HashMap, HashSet};
+    use std::sync::Mutex;
+    use std::sync::atomic::{AtomicBool, Ordering};
+
+    static WATCHED: AtomicBool = AtomicBool::new(false);
+    static CHANGED: Mutex<Option<HashMap<String, HashSet<(i32, i32)>>>> = Mutex::new(None);
+
+    pub fn watched() -> bool {
+        WATCHED.load(Ordering::Relaxed)
+    }
+    /// Whether anyone looks through a portal now; off, nothing is collected.
+    pub fn set_watched(on: bool) {
+        if !WATCHED.swap(on, Ordering::Relaxed) || on {
+            return;
+        }
+        if let Ok(mut c) = CHANGED.lock() {
+            *c = None;
+        }
+    }
+    pub fn mark(level: &str, x: i32, z: i32) {
+        if let Ok(mut c) = CHANGED.lock() {
+            let map = c.get_or_insert_with(HashMap::new);
+            let set = map.entry(level.to_owned()).or_default();
+            if set.len() < 4096 {
+                set.insert((x, z));
+            }
+        }
+    }
+    /// The columns of `level` changed since the last call.
+    pub fn take(level: &str) -> HashSet<(i32, i32)> {
+        CHANGED
+            .lock()
+            .ok()
+            .and_then(|mut c| c.as_mut().and_then(|m| m.remove(level)))
+            .unwrap_or_default()
+    }
+}

+//! Horizon portals, stage 3: looking into a lit Nether portal shows the linked dimension, live.
+//!
+//! - The client asks (`horizon:portal_view`, Horizon servers only) for the other side of the
+//!   portal it stands near, about once a second while it does.
+//! - The server finds the exit portal (the linked one, else the closest to the scaled
+//!   position), keeps the chunks around it loaded with a mod ticket, and sends them.
+//! - The client keeps those chunks far east of everything (`VIRTUAL_X`), where they mesh as any
+//!   others, and the renderer's portal pass draws them from a camera carried through the portal
+//!   (`Renderer::set_portal_view`).
+//!
+//! `HORIZON_PORTAL_VIEW_TEST="dx,dy,dz"` still shows the same world moved, for tests.
+use super::{Dim, Game, lan::LanHost};
+use horizon_client::{
+    fast_hash::FxHashSet,
+    gfx::PortalView,
+    lan::conn::PlayerSender,
+    world::World,
+};
+use horizon_core::{
+    geometry::{Axis, Vec3},
+    position::BlockPos,
+};
+use horizon_protocol::{
+    buf::{Reader, Writer},
+    packets::{
+        configuration::CustomPayload,
+        play::{self, Clientbound as C},
+    },
+    registry::DimensionType,
+};
+use horizon_world::level::portal_travel::{FoundRectangle, closest_portal, largest_rectangle_around};
+use std::{
+    cell::{Cell, RefCell},
+    collections::HashMap,
+    sync::Mutex,
+    time::{Duration, Instant},
+};
+
+pub(super) const CHANNEL: &str = "horizon:portal_view";
+/// How far from the camera a portal is looked for, in blocks.
+const REACH: i32 = 16;
+/// The other side's chunks sit this many chunks east of where they are.
+pub(super) const VIRTUAL_X: i32 = 1 << 20;
+/// Chunks around the exit portal sent, each way.
+const RADIUS: i32 = 3;
+/// How often the client asks while near a portal, and how long the server keeps a view no
+/// one asks for.
+const ASK_EVERY: Duration = Duration::from_millis(1000);
+const KEEP_FOR: Duration = Duration::from_secs(4);
+/// Columns sent per tick.
+const PER_TICK: usize = 49;
+const OWNER: &str = "horizon:portal_view";
+
+/// How long the last frame before a portal may stay up while the level behind it draws.
+const HOLD_FOR: Duration = Duration::from_millis(200);
+const HEADER: u8 = 0;
+const CHUNK: u8 = 1;
+const CLEAR: u8 = 2;
+
+/// The sky light a skyless level's blocks show through a portal in a level with a sky.
+const NETHER_SKY: u8 = 9;
+
+/// Every block of `chunk` at least `sky` sky light.
+fn brighten(chunk: &mut horizon_client::chunk::Chunk, sky: u8) {
+    use horizon_client::chunk::Light;
+    for section in &mut chunk.sections {
+        let s = std::sync::Arc::make_mut(section);
+        let mut data = Box::new([0u8; 4096]);
+        for (i, v) in data.iter_mut().enumerate() {
+            let old = s.light.get(i);
+            *v = (old >> 4).max(sky) << 4 | (old & 15);
+        }
+        s.light = Light::packed(data);
+    }
+}
+
+/// A level without a sky takes back the sky light `brighten` lent its columns.
+fn darken(chunk: &mut horizon_client::chunk::Chunk) {
+    use horizon_client::chunk::Light;
+    for section in &mut chunk.sections {
+        let s = std::sync::Arc::make_mut(section);
+        let mut data = Box::new([0u8; 4096]);
+        for (i, v) in data.iter_mut().enumerate() {
+            *v = s.light.get(i) & 15;
+        }
+        s.light = Light::packed(data);
+    }
+}
+
+/// Entering `level`: the view is forgotten, and when `level` is the level it showed, its
+/// columns are handed over, at their own places there (none of the level's if it was another).
+pub(super) fn take_other_side(
+    world: &mut World,
+    level: &str,
+) -> Option<Vec<horizon_client::chunk::Chunk>> {
+    LAST.set(None);
+    ASKED.set(None);
+    ENTERED.set(None);
+    let o = OTHER.take().filter(|o| o.dim == level)?;
+    let dark = !DimensionType::vanilla(level).has_skylight;
+    Some(
+        o.chunks
+            .iter()
+            .filter_map(|key| {
+                let chunk = world.chunks.remove(key)?;
+                let mut chunk = std::sync::Arc::try_unwrap(chunk).unwrap_or_else(|c| (*c).clone());
+                chunk.x -= VIRTUAL_X;
+                if dark {
+                    darken(&mut chunk);
+                }
+                Some(chunk)
+            })
+            .collect(),
+    )
+}
+
+/// Sets aside the player a portal's Respawn replaces, for a landing that keeps it.
+pub(super) fn carry(player: Option<horizon_client::motion::PlayerMotion>) {
+    CARRIED.set(player);
+}
+pub(super) fn take_carried() -> Option<horizon_client::motion::PlayerMotion> {
+    CARRIED.take()
+}
+/// The player has just walked through a portal into the level it showed.
+pub(super) fn went_through() {
+    let now = Instant::now();
+    WENT.set(Some(now));
+    HELD.set(Some(now));
+}
+/// Whether it did within the last moments: it walks on while the level's loading ends.
+pub(super) fn walking_through() -> bool {
+    WENT.get().is_some_and(|t| t.elapsed() < Duration::from_secs(2))
+}
+
+/// Whether the chunk column `x` is one of the other side's.
+pub(super) fn is_virtual(x: i32) -> bool {
+    x >= VIRTUAL_X - (1 << 18)
+}
+
+fn test_offset() -> Option<glam::DVec3> {
+    let v = std::env::var("HORIZON_PORTAL_VIEW_TEST").ok()?;
+    let n: Vec<f64> = v.split(',').filter_map(|s| s.trim().parse().ok()).collect();
+    (n.len() == 3).then(|| glam::DVec3::new(n[0], n[1], n[2]))
+}
+
+/// A portal near the camera: its blocks' box and the axis it faces.
+#[derive(Clone, Copy, PartialEq)]
+struct Near {
+    min: [i32; 3],
+    max: [i32; 3],
+    normal_axis: usize,
+}
+
+/// What the client heard of the other side.
+struct Other {
+    /// The client's level when it heard it.
+    level: String,
+    /// The other side's dimension.
+    dim: String,
+    /// The entry portal's corner the server answered for.
+    entry: [i32; 3],
+    exit_min: [i32; 3],
+    exit_x_axis: bool,
+    exit_size: [i32; 2],
+    /// The other side's columns held, at their virtual places.
+    chunks: FxHashSet<(i32, i32)>,
+}
+
+thread_local! {
+    /// The last search: the camera's block and what it found.
+    static LAST: Cell<Option<([i32; 3], Instant, Option<Near>)>> = const { Cell::new(None) };
+    static ASKED: Cell<Option<([i32; 3], Instant)>> = const { Cell::new(None) };
+    static OTHER: RefCell<Option<Other>> = const { RefCell::new(None) };
+    /// The player a portal's Respawn set aside (`carry`).
+    static CARRIED: RefCell<Option<horizon_client::motion::PlayerMotion>> =
+        const { RefCell::new(None) };
+    /// When the player last walked through a portal into the level it showed.
+    static WENT: Cell<Option<Instant>> = const { Cell::new(None) };
+    /// The walk through (`WENT`) whose last frame is still held up.
+    static HELD: Cell<Option<Instant>> = const { Cell::new(None) };
+    /// The portal whose blocks the camera is in: its corner, the side of its plane the
+    /// camera came in from, and when the camera went through the plane.
+    static ENTERED: Cell<Option<([i32; 3], f32, Option<Instant>)>> = const { Cell::new(None) };
+}
+
+/// `PortalView::entered` for the camera at `camera` near the portal `near`: the side it came
+/// into the portal's blocks from, kept while it is in them and, once through the plane, for
+/// the moment the server takes to move the player (a player the server leaves where it is
+/// sees its own side again).
+fn entered_side(near: &Near, camera: glam::DVec3) -> f32 {
+    let a = near.normal_axis.min(2);
+    let centre = f64::from(near.min[a] + near.max[a] + 1) / 2.0 - camera[a];
+    let inside = centre.abs() < 0.5;
+    match ENTERED.get().filter(|(corner, ..)| *corner == near.min) {
+        Some((corner, side, crossed)) => {
+            let past = f64::from(side) * centre < 0.0;
+            let crossed = match (past, crossed) {
+                (false, _) => None,
+                (true, None) => Some(Instant::now()),
+                (true, at) => at,
+            };
+            let keep = match crossed {
+                Some(at) => centre.abs() < 2.0 && at.elapsed() < Duration::from_millis(600),
+                None => inside,
+            };
+            if keep {
+                ENTERED.set(Some((corner, side, crossed)));
+                side
+            } else {
+                ENTERED.set(None);
+                0.0
+            }
+        }
+        None if inside => {
+            let side = if centre >= 0.0 { 1.0 } else { -1.0 };
+            ENTERED.set(Some((near.min, side, None)));
+            side
+        }
+        None => {
+            ENTERED.set(None);
+            0.0
+        }
+    }
+}
+
+impl Game<'_> {
+    /// Whether this frame is left undrawn: for a moment after the player walked through a
+    /// portal, until the section it came out in is drawn and those around it are done
+    /// meshing, the last frame (the same place, seen through the portal) stays up.
+    pub(super) fn portal_arrival_hold(&self) -> bool {
+        let Some(went) = WENT.get() else {
+            return false;
+        };
+        if HELD.get() != Some(went) {
+            return false;
+        }
+        let hold = went.elapsed() < HOLD_FOR
+            && self.player.as_ref().is_some_and(|player| {
+                let p = player.position;
+                let (cx, cz) = ((p.x.floor() as i32) >> 4, (p.z.floor() as i32) >> 4);
+                let sy = (p.y.floor() as i32 - self.world.shape.min_y) >> 4;
+                let drawn = self
+                    .renderer
+                    .as_ref()
+                    .is_none_or(|r| r.has_section((cx, sy, cz)));
+                !drawn
+                    || (-1..=1).any(|dy| {
+                        (-1..=1).any(|dz| {
+                            (-1..=1).any(|dx| {
+                                let key = (cx + dx, sy + dy, cz + dz);
+                                self.streaming.is_meshing(key)
+                                    || self.pending_uploads.iter().any(|(s, _)| *s == key)
+                            })
+                        })
+                    })
+            });
+        if !hold {
+            HELD.set(None);
+            log::info!(
+                "Horizon portals: through the portal, drawing again after {} ms",
+                went.elapsed().as_millis()
+            );
+        }
+        hold
+    }
+
+    /// The nearest portal within reach of `camera` and where it shows, asking the server for
+    /// its other side while near it.
+    pub(super) fn portal_view_for_frame(&mut self, camera: glam::DVec3) -> Option<PortalView> {
+        let view = self.portal_view_here(camera);
+        // Its blocks give off no particles while their surface shows the other side.
+        if let Ok(mut seamless) = horizon_client::animate_tick::SEAMLESS_PORTAL.lock() {
+            *seamless = view.map(|v| (v.min, v.max));
+        }
+        view
+    }
+
+    fn portal_view_here(&mut self, camera: glam::DVec3) -> Option<PortalView> {
+        let at = [
+            camera.x.floor() as i32,
+            camera.y.floor() as i32,
+            camera.z.floor() as i32,
+        ];
+        // Looked for again when the camera moves to another block, and every half second
+        // (blocks change, and chunks arrive after a teleport).
+        let near = match LAST.get() {
+            Some((block, when, found))
+                if block == at && when.elapsed() < Duration::from_millis(500) =>
+            {
+                found
+            }
+            _ => {
+                let found = self.find_portal_near(at);
+                LAST.set(Some((at, Instant::now(), found)));
+                found
+            }
+        }?;
+        if let Some(offset) = test_offset() {
+            return Some(PortalView {
+                min: near.min,
+                max: near.max,
+                normal_axis: near.normal_axis,
+                offset,
+                yaw: 0.0,
+                clear: None,
+                sky: true,
+                entered: 0.0,
+                blank: false,
+            });
+        }
+        let entered = entered_side(&near, camera);
+        let time = self.view_day_time();
+        // A portal's blocks draw nothing of their own (`Mesher`): with nothing of the other
+        // side here (not heard of yet, or a server that shows none), the colour of where a
+        // portal from this level leads.
+        let blank = PortalView {
+            min: near.min,
+            max: near.max,
+            normal_axis: near.normal_axis,
+            offset: glam::DVec3::ZERO,
+            yaw: 0.0,
+            clear: Some(match self.dim {
+                Dim::Nether => self.res.environment().sample(time, None, None).fog_color,
+                _ => [0.2, 0.03, 0.03],
+            }),
+            sky: false,
+            entered,
+            blank: true,
+        };
+        let Some(level) = self.remote.as_ref().map(|r| r.level.clone()) else {
+            return Some(blank);
+        };
+        self.forget_stale_other(&level);
+        // At once for a portal not asked about yet, then once a second.
+        if ASKED
+            .get()
+            .is_none_or(|(corner, t)| corner != near.min || t.elapsed() >= ASK_EVERY)
+        {
+            ASKED.set(Some((near.min, Instant::now())));
+            let mut w = Writer::new();
+            for v in near.min.into_iter().chain(near.max) {
+                w.i32(v);
+            }
+            self.send(play::Serverbound::CustomPayload(CustomPayload {
+                channel: CHANNEL.into(),
+                data: w.data,
+            }));
+        }
+        let here_sky = self.remote.as_ref().is_some_and(|r| r.dimension.has_skylight);
+        let view = OTHER.with_borrow(|other| {
+            let o = other.as_ref()?;
+            // Walking through draws on with the shader pack: it is built for there now.
+            super::shader_packs::build_ahead_for(Dim::from_id(&o.dim));
+            let env = match o.dim.as_str() {
+                "minecraft:the_nether" => self.res.nether_environment(),
+                "minecraft:the_end" => self.res.end_environment(),
+                _ => self.res.environment(),
+            };
+            let other_sky = DimensionType::vanilla(&o.dim).has_skylight;
+            // The level's fog colour; the Nether's comes from its biomes, so its wastes' red.
+            let fog = env.sample(time, None, None).fog_color;
+            let clear = Some(if fog.iter().all(|&c| c < 0.01) && o.dim == "minecraft:the_nether" {
+                [0.2, 0.03, 0.03]
+            } else {
+                fog
+            });
+            let inside = (0..3).all(|i| (near.min[i]..=near.max[i]).contains(&o.entry[i]));
+            if !inside || o.chunks.is_empty() {
+                return None;
+            }
+            let flat = near.normal_axis == 1;
+            let entry_x_axis = near.normal_axis == 2;
+            // Bottom middles, the exit's at its virtual place; a flat portal's middle meets
+            // the exit portal's middle, so looking down it shows the ground around that.
+            let entry = glam::DVec3::new(
+                f64::from(near.min[0] + near.max[0] + 1) / 2.0,
+                f64::from(near.min[1]) + if flat { 0.5 } else { 0.0 },
+                f64::from(near.min[2] + near.max[2] + 1) / 2.0,
+            );
+            let [ex, ey, ez] = o.exit_min.map(f64::from);
+            let half = f64::from(o.exit_size[0]) / 2.0;
+            let ey = if flat { ey + f64::from(o.exit_size[1]) / 2.0 } else { ey };
+            let exit = if o.exit_x_axis {
+                glam::DVec3::new(ex + half, ey, ez + 0.5)
+            } else {
+                glam::DVec3::new(ex + 0.5, ey, ez + half)
+            } + glam::DVec3::new(f64::from(VIRTUAL_X) * 16.0, 0.0, 0.0);
+            let yaw: f32 = match (entry_x_axis, o.exit_x_axis) {
+                _ if flat => 0.0,
+                (a, b) if a == b => 0.0,
+                (true, false) => -std::f32::consts::FRAC_PI_2,
+                _ => std::f32::consts::FRAC_PI_2,
+            };
+            let turn = glam::DQuat::from_rotation_y(f64::from(yaw));
+            let through = exit + turn * (camera - entry);
+            Some(PortalView {
+                min: near.min,
+                max: near.max,
+                normal_axis: near.normal_axis,
+                offset: through - camera,
+                yaw,
+                clear,
+                sky: here_sky && other_sky,
+                entered,
+                blank: false,
+            })
+        });
+        Some(view.unwrap_or(blank))
+    }
+
+    /// The other side heard in another level is gone with that level's chunks.
+    fn forget_stale_other(&mut self, level: &str) {
+        let stale = OTHER.with_borrow(|o| o.as_ref().is_some_and(|o| o.level != level));
+        if stale {
+            self.forget_other();
+        }
+    }
+
+    fn forget_other(&mut self) {
+        let Some(o) = OTHER.take() else {
+            return;
+        };
+        for key in &o.chunks {
+            self.streaming.mod_forced.remove(key);
+        }
+        let mut gone: FxHashSet<(i32, i32)> = o
+            .chunks
+            .iter()
+            .copied()
+            .filter(|k| self.world.chunks.contains_key(k))
+            .collect();
+        if !gone.is_empty() {
+            self.forget_remote_columns(&mut gone);
+        }
+    }
+
+    /// A `horizon:portal_view` payload from the server.
+    pub(super) fn remote_portal_view(&mut self, data: &[u8]) {
+        let Some(level) = self.remote.as_ref().map(|r| r.level.clone()) else {
+            return;
+        };
+        self.forget_stale_other(&level);
+        let mut r = Reader::new(data);
+        match r.u8() {
+            Ok(HEADER) => {
+                let read = |r: &mut Reader| -> horizon_protocol::Result<_> {
+                    let dim = r.string(256)?;
+                    let entry = [r.i32()?, r.i32()?, r.i32()?];
+                    let exit_min = [r.i32()?, r.i32()?, r.i32()?];
+                    let x_axis = r.bool()?;
+                    let size = [r.i32()?, r.i32()?];
+                    Ok((dim, entry, exit_min, x_axis, size))
+                };
+                let Ok((dim, entry, exit_min, exit_x_axis, exit_size)) = read(&mut r) else {
+                    return;
+                };
+                let same = OTHER.with_borrow(|o| {
+                    o.as_ref()
+                        .is_some_and(|o| o.dim == dim && o.exit_min == exit_min)
+                });
+                if !same {
+                    self.forget_other();
+                }
+                log::info!(
+                    "Horizon portals: the other side of {entry:?} is {dim} at {exit_min:?}"
+                );
+                OTHER.with_borrow_mut(|o| match o {
+                    Some(o) if same => {
+                        o.entry = entry;
+                        o.exit_x_axis = exit_x_axis;
+                        o.exit_size = exit_size;
+                    }
+                    _ => {
+                        *o = Some(Other {
+                            level,
+                            dim,
+                            entry,
+                            exit_min,
+                            exit_x_axis,
+                            exit_size,
+                            chunks: Default::default(),
+                        })
+                    }
+                });
+            }
+            Ok(CHUNK) => {
+                let body = r.rest();
+                let mut b = Reader::new(body);
+                let Ok(id) = b.varint() else {
+                    return;
+                };
+                let Ok(C::LevelChunkWithLight(mut p)) = C::decode(id, b.rest()) else {
+                    return;
+                };
+                let Some(dim) = OTHER.with_borrow(|o| o.as_ref().map(|o| o.dim.clone())) else {
+                    return;
+                };
+                let Some(format) = self
+                    .remote
+                    .as_ref()
+                    .map(|r| r.chunk_format.with_dimension(&DimensionType::vanilla(&dim)))
+                else {
+                    return;
+                };
+                p.x += VIRTUAL_X;
+                let mut chunk = match format.column(&p) {
+                    Ok(c) => c,
+                    Err(e) => {
+                        log::warn!("Horizon portals: chunk {} {}: {e}", p.x, p.z);
+                        return;
+                    }
+                };
+                // A level without a sky seen from one with it: its dark air takes some sky
+                // light, as the Nether's own ambient light shows it there.
+                if !DimensionType::vanilla(&dim).has_skylight
+                    && self.remote.as_ref().is_some_and(|r| r.dimension.has_skylight)
+                {
+                    brighten(&mut chunk, NETHER_SKY);
+                }
+                let key = (p.x, p.z);
+                self.streaming.mod_forced.insert(key);
+                if self.world.chunks.contains_key(&key) {
+                    self.streaming.replace_remote(&mut self.world, chunk);
+                } else {
+                    self.streaming.insert_remote(&mut self.world, chunk);
+                }
+                OTHER.with_borrow_mut(|o| {
+                    if let Some(o) = o {
+                        o.chunks.insert(key);
+                    }
+                });
+            }
+            Ok(CLEAR) => self.forget_other(),
+            _ => {}
+        }
+    }
+
+    /// The portal blocks nearest `at`: their box and the axis the portal faces.
+    fn find_portal_near(&self, at: [i32; 3]) -> Option<Near> {
+        let b = self.res.behaviours();
+        let mut best: Option<(i32, [i32; 3])> = None;
+        for dy in -REACH..=REACH {
+            for dz in -REACH..=REACH {
+                for dx in -REACH..=REACH {
+                    let p = [at[0] + dx, at[1] + dy, at[2] + dz];
+                    let state = self.world.block(p[0], p[1], p[2]);
+                    if b.portal_axis(state).is_none() {
+                        continue;
+                    }
+                    let d = dx * dx + dy * dy + dz * dz;
+                    if best.is_none_or(|(bd, _)| d < bd) {
+                        best = Some((d, p));
+                    }
+                }
+            }
+        }
+        let (_, p) = best?;
+        let state = self.world.block(p[0], p[1], p[2]);
+        let (axis1, axis2, normal_axis) = if b.is_flat_portal(state) {
+            (Axis::X, Axis::Z, 1)
+        } else if b.portal_axis(state) == Some(true) {
+            (Axis::X, Axis::Y, 2)
+        } else {
+            (Axis::Z, Axis::Y, 0)
+        };
+        let rect = largest_rectangle_around(
+            BlockPos::new(p[0], p[1], p[2]),
+            axis1,
+            64,
+            axis2,
+            64,
+            |q| self.world.block(q.x, q.y, q.z) == state,
+        );
+        let min = rect.min_corner;
+        let grow = |axis: Axis| match axis {
+            Axis::X => [1, 0, 0],
+            Axis::Y => [0, 1, 0],
+            Axis::Z => [0, 0, 1],
+        };
+        let (g1, g2) = (grow(axis1), grow(axis2));
+        let max = [
+            min.x + g1[0] * (rect.axis1_size - 1) + g2[0] * (rect.axis2_size - 1),
+            min.y + g1[1] * (rect.axis1_size - 1) + g2[1] * (rect.axis2_size - 1),
+            min.z + g1[2] * (rect.axis1_size - 1) + g2[2] * (rect.axis2_size - 1),
+        ];
+        Some(Near {
+            min: [min.x, min.y, min.z],
+            max,
+            normal_axis,
+        })
+    }
+}
+
+// The server's side.
+
+/// A player looking into a portal.
+struct Viewer {
+    /// The level the player is in.
+    dim: Dim,
+    /// The entry portal's corner and its axis.
+    entry: BlockPos,
+    entry_x_axis: bool,
+    entry_size: [i32; 2],
+    target: Dim,
+    /// Where the exit is looked for (linked, else scaled).
+    guess: BlockPos,
+    /// The exit portal: corner, x axis, sizes.
+    exit: Option<(BlockPos, bool, [i32; 2])>,
+    told: bool,
+    /// The chunks its tickets hold.
+    held: Vec<(i32, i32)>,
+    sent: FxHashSet<(i32, i32)>,
+    asked: Instant,
+    since: Instant,
+}
+
+static VIEWERS: Mutex<Option<HashMap<u32, Viewer>>> = Mutex::new(None);
+
+fn send(sender: &PlayerSender, data: Vec<u8>) {
+    let packet = play::Clientbound::CustomPayload(CustomPayload {
+        channel: CHANNEL.into(),
+        data,
+    });
+    sender.send(packet.encode());
+}
+
+impl Game<'_> {
+    fn level_world(&self, dim: Dim) -> Option<&World> {
+        if dim == self.dim {
+            Some(&self.world)
+        } else {
+            self.levels.parked_world(dim)
+        }
+    }
+
+    fn hold_view_chunks(&mut self, dim: Dim, centre: (i32, i32), held: &mut Vec<(i32, i32)>) {
+        self.release_view_chunks(dim, held);
+        for dz in -RADIUS..=RADIUS {
+            for dx in -RADIUS..=RADIUS {
+                let c = (centre.0 + dx, centre.1 + dz);
+                if self.native_force_chunk_in(OWNER, dim.id(), [c.0, c.1], true) {
+                    held.push(c);
+                }
+            }
+        }
+    }
+
+    fn release_view_chunks(&mut self, dim: Dim, held: &mut Vec<(i32, i32)>) {
+        for c in held.drain(..) {
+            self.native_force_chunk_in(OWNER, dim.id(), [c.0, c.1], false);
+        }
+    }
+
+    /// A `horizon:portal_view` request from `conn`: the corner of the portal it stands near.
+    pub(super) fn guest_portal_view(&mut self, host: &mut LanHost, conn: u32, data: &[u8]) {
+        let Some(guest) = host.hub.guest(conn).filter(|g| g.brand == "horizon") else {
+            return;
+        };
+        let dim = Dim::from_id(&guest.dimension);
+        let target = match dim {
+            Dim::Overworld => Dim::Nether,
+            Dim::Nether => Dim::Overworld,
+            Dim::End => return,
+        };
+        let mut r = Reader::new(data);
+        let (Ok(x), Ok(y), Ok(z)) = (r.i32(), r.i32(), r.i32()) else {
+            return;
+        };
+        let b = self.res.behaviours();
+        let Some(world) = self.level_world(dim) else {
+            return;
+        };
+        let state = world.block(x, y, z);
+        let Some(x_axis) = b.portal_axis(state) else {
+            return;
+        };
+        // A flat portal: its box as the client found it (its outline can be any shape).
+        let flat = b.is_flat_portal(state);
+        let (corner, size, centre) = if flat {
+            let max = [r.i32().unwrap_or(x), r.i32().unwrap_or(y), r.i32().unwrap_or(z)];
+            let (sx, sz) = ((max[0] - x + 1).clamp(1, 64), (max[2] - z + 1).clamp(1, 64));
+            (
+                BlockPos::new(x, y, z),
+                [sx.max(2), 3],
+                (f64::from(x) + f64::from(sx) / 2.0, f64::from(z) + f64::from(sz) / 2.0),
+            )
+        } else {
+            let rect = largest_rectangle_around(
+                BlockPos::new(x, y, z),
+                if x_axis { Axis::X } else { Axis::Z },
+                64,
+                Axis::Y,
+                64,
+                |p| world.block(p.x, p.y, p.z) == state,
+            );
+            let c = rect.min_corner;
+            let along = f64::from(rect.axis1_size) / 2.0;
+            let centre = if x_axis {
+                (f64::from(c.x) + along, f64::from(c.z) + 0.5)
+            } else {
+                (f64::from(c.x) + 0.5, f64::from(c.z) + along)
+            };
+            (c, [rect.axis1_size, rect.axis2_size], centre)
+        };
+        let x_axis = x_axis || flat;
+        let mut guard = VIEWERS.lock().unwrap();
+        let viewers = guard.get_or_insert_with(HashMap::new);
+        if let Some(v) = viewers.get_mut(&conn)
+            && v.dim == dim
+            && v.entry == corner
+        {
+            v.asked = Instant::now();
+            return;
+        }
+        let old = viewers.remove(&conn);
+        // NetherPortalFix's link, else the scaled position (`portal_plan`, without planning a trip).
+        let scale = if dim == Dim::Nether { 8.0 } else { 1.0 / 8.0 };
+        let guess = self
+            .portal_link(dim == Dim::Nether, corner)
+            .filter(|_| !flat)
+            .unwrap_or_else(|| {
+                self.border_bounds_of(target).clamp(
+                    centre.0 * scale,
+                    f64::from(corner.y),
+                    centre.1 * scale,
+                )
+            });
+        drop(guard);
+        if let Some(mut old) = old {
+            self.release_view_chunks(old.target, &mut old.held);
+        }
+        let mut held = Vec::new();
+        self.hold_view_chunks(target, (guess.x >> 4, guess.z >> 4), &mut held);
+        log::info!(
+            "Horizon portals: player {conn} looks into the portal at {corner:?}; the other side is looked for at {guess:?} in {}",
+            target.id()
+        );
+        let now = Instant::now();
+        VIEWERS.lock().unwrap().get_or_insert_with(HashMap::new).insert(
+            conn,
+            Viewer {
+                dim,
+                entry: corner,
+                entry_x_axis: x_axis,
+                entry_size: size,
+                target,
+                guess,
+                exit: None,
+                told: false,
+                held,
+                sent: Default::default(),
+                asked: now,
+                since: now,
+            },
+        );
+    }
+
+    /// The exit portal near `guess` in `world`, from its loaded chunks.
+    fn find_view_exit(
+        &self,
+        world: &World,
+        target: Dim,
+        guess: BlockPos,
+    ) -> Option<(BlockPos, bool, [i32; 2])> {
+        let b = self.res.behaviours();
+        let to_nether = target == Dim::Nether;
+        let radius = if to_nether { 16 } else { 128 };
+        let chunk_radius = radius / 16 + 1;
+        let (cx, cz) = (guess.x >> 4, guess.z >> 4);
+        let mut portals = Vec::new();
+        for z in cz - chunk_radius..=cz + chunk_radius {
+            for x in cx - chunk_radius..=cx + chunk_radius {
+                let Some(chunk) = world.chunks.get(&(x, z)) else {
+                    continue;
+                };
+                for (s, section) in chunk.sections.iter().enumerate() {
+                    if !section.blocks.maybe_has(|v| {
+                        b.portal_axis(horizon_world::registry::BlockStateId(v))
+                            .is_some()
+                    }) {
+                        continue;
+                    }
+                    let base = world.bottom_y() + 16 * s as i32;
+                    for y in base..base + 16 {
+                        for lz in 0..16 {
+                            for lx in 0..16 {
+                                let (wx, wz) = (x * 16 + lx, z * 16 + lz);
+                                let state = chunk.block(wx, y, wz);
+                                if b.portal_axis(state).is_some() && !b.is_flat_portal(state) {
+                                    portals.push(BlockPos::new(wx, y, wz));
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        let (min_section, max_section) = if to_nether { (0, 15) } else { (-4, 19) };
+        let found = closest_portal(
+            &portals,
+            guess,
+            to_nether,
+            &self.border_bounds_of(target),
+            min_section,
+            max_section,
+        )?;
+        let state = world.block(found.x, found.y, found.z);
+        let x_axis = b.portal_axis(state).unwrap_or(true);
+        let rect: FoundRectangle = largest_rectangle_around(
+            found,
+            if x_axis { Axis::X } else { Axis::Z },
+            64,
+            Axis::Y,
+            64,
+            |p| world.block(p.x, p.y, p.z) == state,
+        );
+        Some((rect.min_corner, x_axis, [rect.axis1_size, rect.axis2_size]))
+    }
+
+    /// Each tick: the views no one asks for any more let go of their chunks; the others find
+    /// their exits and send what of the other side is loaded.
+    pub(super) fn tick_portal_views(&mut self, host: &mut LanHost) {
+        let Some(mut viewers) = VIEWERS.lock().unwrap().take() else {
+            horizon_client::lan::hub::portal_changes::set_watched(false);
+            return;
+        };
+        horizon_client::lan::hub::portal_changes::set_watched(!viewers.is_empty());
+        // What changed on the other sides since the last tick is sent again.
+        let mut changed: HashMap<&'static str, std::collections::HashSet<(i32, i32)>> =
+            HashMap::new();
+        for v in viewers.values() {
+            changed
+                .entry(v.target.id())
+                .or_insert_with(|| horizon_client::lan::hub::portal_changes::take(v.target.id()));
+        }
+        // The levels looked into keep a log of their changed blocks (a level with no player in it
+        // keeps none), which the hub reads when it ticks them.
+        let targets: std::collections::HashSet<Dim> = viewers.values().map(|v| v.target).collect();
+        for dim in targets {
+            let world = if dim == self.dim {
+                Some(&mut self.world)
+            } else {
+                self.levels.parked_world_mut(dim)
+            };
+            if let Some(w) = world {
+                w.block_log.get_or_insert_with(Vec::new);
+            }
+        }
+        for v in viewers.values_mut() {
+            if let Some(set) = changed.get(v.target.id()) {
+                for c in set {
+                    v.sent.remove(c);
+                }
+            }
+        }
+        let mut gone = Vec::new();
+        for (&conn, v) in viewers.iter_mut() {
+            let guest = host.hub.guest(conn);
+            let left = guest.is_none_or(|g| Dim::from_id(&g.dimension) != v.dim);
+            if left || v.asked.elapsed() > KEEP_FOR {
+                gone.push(conn);
+                if let Some(g) = guest {
+                    send(&g.sender, vec![CLEAR]);
+                }
+                continue;
+            }
+            let guest = guest.expect("checked");
+            if v.exit.is_none() {
+                let found = self
+                    .level_world(v.target)
+                    .and_then(|w| self.find_view_exit(w, v.target, v.guess));
+                let loaded = self.level_world(v.target).is_some_and(|w| {
+                    v.held.iter().all(|c| w.chunks.contains_key(c))
+                });
+                let exit = match found {
+                    Some(e) => Some(e),
+                    // No portal there: the place one would be.
+                    None if loaded || v.since.elapsed() > Duration::from_secs(10) => {
+                        Some((v.guess, v.entry_x_axis, v.entry_size))
+                    }
+                    None => None,
+                };
+                if let Some((corner, x_axis, size)) = exit {
+                    let centre = (corner.x >> 4, corner.z >> 4);
+                    if centre != (v.guess.x >> 4, v.guess.z >> 4) {
+                        let mut held = std::mem::take(&mut v.held);
+                        self.hold_view_chunks(v.target, centre, &mut held);
+                        v.held = held;
+                    }
+                    log::info!(
+                        "Horizon portals: the other side of {:?} is {:?} in {}",
+                        v.entry,
+                        corner,
+                        v.target.id()
+                    );
+                    v.exit = Some((corner, x_axis, size));
+                }
+            }
+            let Some((corner, x_axis, size)) = v.exit else {
+                continue;
+            };
+            if !v.told {
+                let mut w = Writer::new();
+                w.u8(HEADER);
+                w.string(v.target.id());
+                for c in [v.entry.x, v.entry.y, v.entry.z, corner.x, corner.y, corner.z] {
+                    w.i32(c);
+                }
+                w.bool(x_axis);
+                w.i32(size[0]);
+                w.i32(size[1]);
+                send(&guest.sender, w.data);
+                v.told = true;
+            }
+            let Some(world) = self.level_world(v.target) else {
+                continue;
+            };
+            let (cx, cz) = (corner.x >> 4, corner.z >> 4);
+            let mut todo: Vec<(i32, i32)> = Vec::new();
+            for dz in -RADIUS..=RADIUS {
+                for dx in -RADIUS..=RADIUS {
+                    let c = (cx + dx, cz + dz);
+                    if !v.sent.contains(&c) && world.chunks.contains_key(&c) {
+                        todo.push(c);
+                    }
+                }
+            }
+            if todo.is_empty() {
+                continue;
+            }
+            todo.sort_by_key(|c| (c.0 - cx).pow(2) + (c.1 - cz).pow(2));
+            todo.truncate(PER_TICK);
+            let mut encoder = host.hub.encoder.detached();
+            encoder.set_dimension(host.hub.config.levels.get(v.target.id()));
+            for c in todo {
+                let chunk = world.chunks[&c].clone();
+                let mut data = vec![CHUNK];
+                data.extend_from_slice(&encoder.body_in(&chunk, world));
+                send(&guest.sender, data);
+                v.sent.insert(c);
+            }
+        }
+        for conn in gone {
+            if let Some(mut v) = viewers.remove(&conn) {
+                self.release_view_chunks(v.target, &mut v.held);
+            }
+        }
+        let mut slot = VIEWERS.lock().unwrap();
+        match slot.as_mut() {
+            // Requests that came meanwhile.
+            Some(new) => {
+                for (k, v) in viewers {
+                    new.entry(k).or_insert(v);
+                }
+            }
+            None => *slot = Some(viewers),
+        }
+    }
+}

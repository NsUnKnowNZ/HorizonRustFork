+/// Horizon portals: the block a horizontal (floor or ceiling) Nether portal
+/// is filled with, from the `horizonportals` content mod. Without that mod
+/// there are no horizontal portals.
+pub const FLAT_PORTAL: &str = "horizonportals:horizontal_portal";
+const HORIZONTAL: [Direction; 4] = [
+    Direction::North,
+    Direction::South,
+    Direction::West,
+    Direction::East,
+];
+
+impl super::Behaviours {
+    pub fn flat_portal(&self) -> Option<super::states::BlockId> {
+        self.table.block_by_name(FLAT_PORTAL)
+    }
+    pub fn is_flat_portal(&self, state: BlockStateId) -> bool {
+        self.flat_portal().is_some_and(|b| self.table.is(state, b))
+    }
+}
+
+impl<L: LevelAccess + ?Sized> Sim<'_, L> {
+    /// A horizontal portal opening around `pos`: the cells of its layer that
+    /// are air, fire or horizontal portal, reached from `pos` across their
+    /// sides, every one of them closed in by the frame (obsidian) at its
+    /// edges, at most 64 by 64 of them. Any outline will do, not only a
+    /// rectangle.
+    pub fn find_flat_portal(&self, pos: BlockPos) -> Option<Vec<BlockPos>> {
+        let flat = self.b.flat_portal()?;
+        let empty = |state: BlockStateId| {
+            self.b.is_air(state)
+                || self
+                    .b
+                    .tag("minecraft:fire")
+                    .is_some_and(|tag| self.b.in_set(state, tag))
+                || self.b.table.is(state, flat)
+        };
+        if !empty(self.state(pos)) {
+            return None;
+        }
+        // Next to the frame at least: no flood through open air.
+        if !HORIZONTAL
+            .iter()
+            .any(|&d| self.portal_frame(self.state(rel(pos, d))))
+        {
+            return None;
+        }
+        let limit = (MAX_WIDTH * MAX_HEIGHT) as usize;
+        let mut seen = std::collections::HashSet::from([pos]);
+        let mut todo = vec![pos];
+        while let Some(at) = todo.pop() {
+            for d in HORIZONTAL {
+                let next = rel(at, d);
+                if seen.contains(&next) {
+                    continue;
+                }
+                let state = self.state(next);
+                if self.portal_frame(state) {
+                    continue;
+                }
+                if !empty(state) {
+                    return None;
+                }
+                seen.insert(next);
+                if seen.len() > limit {
+                    return None;
+                }
+                todo.push(next);
+            }
+        }
+        Some(seen.into_iter().collect())
+    }
+    /// Fills a horizontal opening (flags 18, as `createPortalBlocks`).
+    pub fn create_flat_portal(&mut self, cells: &[BlockPos]) {
+        let Some(flat) = self.b.flat_portal() else {
+            return;
+        };
+        let state = self.b.table.default_state(flat);
+        for &at in cells {
+            self.set_block(at, state, 18);
+        }
+    }
+    /// A horizontal portal block stays while each side is frame or portal:
+    /// a broken frame lets the opening drain away cell by cell.
+    pub fn flat_portal_survives(&self, pos: BlockPos) -> bool {
+        HORIZONTAL.iter().all(|&d| {
+            let state = self.state(rel(pos, d));
+            self.portal_frame(state) || self.b.is_flat_portal(state)
+        })
+    }
+}

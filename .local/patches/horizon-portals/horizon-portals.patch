+        let b = self.res.behaviours();
+        let corner = exit.min_corner;
+        let exit_x_axis = b
+            .portal_axis(self.world.block(corner.x, corner.y, corner.z))
+            .unwrap_or(true);
+        let mut plan = *plan;
+        if plan.entry_x_axis != exit_x_axis {
+            plan.offset.z = -plan.offset.z;
+        }
+        let (width, height) = (f64::from(plan.width), f64::from(plan.height));
+        let across = (f64::from(entry_size[0]) - width).max(0.0);
+        let up = (f64::from(entry_size[1]) - height).max(0.0);
+        let exit_across = f64::from(exit.axis1_size) - width;
+        let exit_up = f64::from(exit.axis2_size) - height;
+        if exit_across > 0.0 {
+            plan.offset.x = (0.5 + (plan.offset.x - 0.5) * across / exit_across).clamp(0.0, 1.0);
+        }
+        if exit_up > 0.0 {
+            plan.offset.y = (plan.offset.y * up / exit_up).clamp(0.0, 1.0);
+        }
+        let (at, rotation) = self.arrival(&plan, exit);
+        let rotation = if !plan.entry_x_axis && exit_x_axis {
+            -rotation
+        } else {
+            rotation
+        };
         (at, rotation)
     }
 

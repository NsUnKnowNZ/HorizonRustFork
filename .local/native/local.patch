+    /// The block and item tag ids commands accept: the world's content
+    /// tables (its data packs' tags over the game's own).
+    pub(super) fn sync_tag_registries(&mut self) {
+        let normalized = |keys: Vec<&String>| {
+            let mut v: Vec<String> = keys
+                .into_iter()
+                .map(|k| horizon_client::command::args::normalize(k))
+                .collect();
+            v.sort();
+            v.dedup();
+            v
+        };
+        let block_tags = normalized(self.items().block_tags.keys().collect());
+        let item_tags = normalized(self.items().item_tags.keys().collect());
+        // `Registries::tags` reads the export's per-registry entry first, so
+        // that entry must list the packs' tags too, not only the field.
+        for (registry, tags) in [("minecraft:block", &block_tags), ("minecraft:item", &item_tags)] {
+            if let Some(entry) = self.ui.registries.by_registry.get_mut(registry) {
+                entry.tags.clone_from(tags);
+            }
+        }
+        self.ui.registries.block_tags = block_tags;
+        self.ui.registries.item_tags = item_tags;
+    }
